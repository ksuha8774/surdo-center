        <mxCell id="booking_edge_services_appointments" value="planned_service_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#405565;strokeWidth=1.25;startFill=0;endFill=0;fontSize=10;fontColor=#314657;labelBackgroundColor=#FFFFFF;startArrow=ERone;endArrow=ERzeroToMany;" parent="1" edge="1" source="booking_services" target="booking_appointments">

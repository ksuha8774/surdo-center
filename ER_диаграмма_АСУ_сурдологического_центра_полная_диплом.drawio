          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="full_legend" value="&lt;b&gt;Обозначения&lt;/b&gt;&lt;br&gt;• Crow’s Foot: 1, 0..1, 0..N и 1..N.&lt;br&gt;• PK — первичный ключ; FK — внешний ключ.&lt;br&gt;• UQ — уникальность; IX — индекс; NULL — необязательное поле.&lt;br&gt;• Типы данных приведены для PostgreSQL.&lt;br&gt;• Поля с префиксом / вычисляются и физически не дублируются.&lt;br&gt;• Сплошная линия обозначает FK-связь." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#F7FAFC;strokeColor=#9AAEBD;fontColor=#263B4A;fontSize=11;shadow=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="2375" y="120" width="440" height="250" />
        </mxCell>
        <mxCell id="full_booking_constraints" value="&lt;b&gt;Запись на приём — слотная модель АСУ ВК&lt;/b&gt;&lt;br&gt;• График и исключения формируют materialized appointment_slots.&lt;br&gt;• Администратор выбирает только слот со status = FREE.&lt;br&gt;• Создание/перенос блокирует слот SELECT FOR UPDATE.&lt;br&gt;• UQ (doctor_id, slot_date, start_time) исключает дубли слотов.&lt;br&gt;• Частичный UQ по slot_id для статусов PLANNED/IN_PROGRESS&lt;br&gt;  запрещает две активные записи на один слот.&lt;br&gt;• При отмене запись сохраняется, а слот снова становится FREE.&lt;br&gt;• doctor/date/time записи получаются через slot_id и не дублируются." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#EEF4FF;strokeColor=#9AAEBD;fontColor=#263B4A;fontSize=11;shadow=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1370" y="1180" width="490" height="330" />
        </mxCell>
        <mxCell id="full_dss_constraints" value="&lt;b&gt;СППР: проверяемость и ответственность врача&lt;/b&gt;&lt;br&gt;• Исходные пороги хранятся в measurements; аудиограмма строится из них.&lt;br&gt;• PTA/ABG и межушная разница сохраняются с версией алгоритма.&lt;br&gt;• Каждый запуск СППР связан с конкретной версией набора правил.&lt;br&gt;• facts_snapshot фиксирует факты, на которых сработало правило.&lt;br&gt;• СППР формирует предварительные вывод и рекомендацию.&lt;br&gt;• Врач подтверждает или отклоняет результат; reviewed_by обязателен&lt;br&gt;  для статусов CONFIRMED/REJECTED.&lt;br&gt;• Окончательное медицинское заключение остаётся в medical_visits.&lt;br&gt;• Исторические правила и исследования физически не удаляются." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFF1F1;strokeColor=#9AAEBD;fontColor=#263B4A;fontSize=11;shadow=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1890" y="1180" width="570" height="360" />
        </mxCell>
        <mxCell id="full_integrity" value="&lt;b&gt;Ключевые CHECK/ENUM&lt;/b&gt;&lt;br&gt;• start_time &lt; end_time.&lt;br&gt;• valid_from ≤ valid_to.&lt;br&gt;• weekday BETWEEN 0 AND 6.&lt;br&gt;• price ≥ 0; amount &gt; 0; quantity &gt; 0.&lt;br&gt;• threshold может быть NULL только при no_response.&lt;br&gt;• current_exam_id ≠ previous_exam_id.&lt;br&gt;• role/status/ear/conduction — ENUM/CHECK.&lt;br&gt;• Медицинские FK — ON DELETE RESTRICT/PROTECT." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFF8E7;strokeColor=#9AAEBD;fontColor=#263B4A;fontSize=11;shadow=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="2490" y="1180" width="325" height="360" />
        </mxCell>
        <mxCell id="full_footer" value="Логико-физическая модель • PostgreSQL • Crow’s Foot • Версия 3.0 от 19.10.2026" style="text;html=1;align=right;verticalAlign=middle;fontSize=10;fontColor=#657987;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1760" y="1985" width="1030" height="24" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="booking" name="2 Детализация записи как в АСУ ВК">
    <mxGraphModel dx="2600" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1500" math="0" shadow="0">
      <root>

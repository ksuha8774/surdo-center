        <mxCell id="measurements" value="&lt;b&gt;AudiometryMeasurements / Аудиометрические измерения&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; measurement_id : bigint&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; exam_id → AudiometryExams.exam_id&lt;br&gt;ear : varchar(5)&lt;br&gt;conduction_type : varchar(10)&lt;br&gt;frequency_hz : integer&lt;br&gt;threshold_db_hl : numeric(5,1) NULL&lt;br&gt;masked : boolean&lt;br&gt;no_response : boolean&lt;br&gt;&lt;b&gt;UQ&lt;/b&gt; (exam_id, ear, conduction_type,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;frequency_hz, masked)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1510" y="430" width="340" height="250" as="geometry"/>
        </mxCell>

        <mxCell id="services" value="&lt;b&gt;Services / Услуги&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; service_id : bigint&lt;br&gt;service_name : varchar(150) &lt;b&gt;UQ&lt;/b&gt;&lt;br&gt;current_price : numeric(10,2)&lt;br&gt;is_active : boolean" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="280" height="155" as="geometry"/>
        </mxCell>

        <mxCell id="payments" value="&lt;b&gt;Payments / Оплаты&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; payment_id : bigint&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; visit_id → MedicalVisits.visit_id&lt;br&gt;amount : numeric(10,2)&lt;br&gt;payment_date : timestamptz&lt;br&gt;payment_method : varchar(20)&lt;br&gt;payment_status : varchar(20)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="900" width="320" height="195" as="geometry"/>
        </mxCell>

        <mxCell id="provided_services" value="&lt;b&gt;ProvidedServices / Оказанные услуги&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; provided_service_id : bigint&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; visit_id → MedicalVisits.visit_id&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; service_id → Services.service_id&lt;br&gt;quantity : numeric(10,2)&lt;br&gt;unit_price_at_time : numeric(10,2)&lt;br&gt;total_amount : numeric(12,2) &lt;i&gt;GENERATED&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="900" width="350" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="dss_results" value="&lt;b&gt;DSSResults / Результаты СППР&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; dss_result_id : bigint&lt;br&gt;&lt;b&gt;FK, UQ&lt;/b&gt; exam_id → AudiometryExams.exam_id&lt;br&gt;pta_right : numeric(5,1) NULL&lt;br&gt;pta_left : numeric(5,1) NULL&lt;br&gt;max_abg_right : numeric(5,1) NULL&lt;br&gt;max_abg_left : numeric(5,1) NULL&lt;br&gt;interaural_difference : numeric(5,1) NULL&lt;br&gt;preliminary_recommendation : text&lt;br&gt;rule_set_version : varchar(30)&lt;br&gt;created_at : timestamptz" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1140" y="900" width="340" height="270" as="geometry"/>
        </mxCell>

        <mxCell id="dss_activations" value="&lt;b&gt;DSSRuleActivations / Сработавшие правила СППР&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; activation_id : bigint&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; dss_result_id → DSSResults.dss_result_id&lt;br&gt;rule_code : varchar(50)&lt;br&gt;rule_version : varchar(30)&lt;br&gt;fact_name : varchar(100)&lt;br&gt;fact_value : varchar(100) NULL&lt;br&gt;description : text&lt;br&gt;&lt;b&gt;UQ&lt;/b&gt; (dss_result_id, rule_code)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1530" y="900" width="350" height="235" as="geometry"/>
        </mxCell>

        <mxCell id="constraints" value="&lt;b&gt;Ключевые ограничения целостности&lt;/b&gt;&lt;hr&gt;• CHECK: weekday BETWEEN 1 AND 7&lt;br&gt;• CHECK: start_time &amp;lt; end_time&lt;br&gt;• CHECK: valid_to IS NULL OR valid_from ≤ valid_to&lt;br&gt;• CHECK: quantity &amp;gt; 0, цены и суммы ≥ 0&lt;br&gt;• CHECK/ENUM: role, sex, status, ear, conduction_type, payment_method, payment_status&lt;br&gt;• Для no_response = true порог может быть NULL&lt;br&gt;• Запрет пересечения активных записей одного врача&lt;br&gt;• Индексы на всех FK, датах и статусах&lt;br&gt;• Медицинскую историю не удалять каскадно; применять RESTRICT/архивацию&lt;br&gt;&lt;br&gt;&lt;b&gt;Обозначения:&lt;/b&gt;&lt;br&gt;UQ — уникальное ограничение&lt;br&gt;GENERATED — вычисляемое поле&lt;br&gt;0..N — связь необязательна со стороны набора дочерних записей" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1920" y="80" width="420" height="440" as="geometry"/>
        </mxCell>

        <mxCell id="note" value="&lt;b&gt;Примечание по отчётам и прогнозированию&lt;/b&gt;&lt;br&gt;Отдельные таблицы для управленческих отчётов и прогноза загрузки не обязательны: показатели рассчитываются запросами по расписанию, записям, приёмам, услугам и оплатам. При необходимости результаты прогнозов можно сохранять отдельным модулем позднее." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1920" y="560" width="420" height="180" as="geometry"/>
        </mxCell>


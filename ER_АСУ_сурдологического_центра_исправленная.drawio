        <mxCell id="appointments" value="&lt;b&gt;Appointments / Записи на приём&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; appointment_id : bigint&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; patient_id → Patients.patient_id&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; doctor_id → DoctorProfiles.user_id&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; created_by → Users.user_id&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; planned_service_id → Services.service_id&lt;br&gt;appointment_date : date&lt;br&gt;start_time : time&lt;br&gt;end_time : time&lt;br&gt;status : varchar(20)&lt;br&gt;comment : text NULL&lt;br&gt;referral_info : text NULL&lt;br&gt;created_at : timestamptz" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="430" width="340" height="315" as="geometry"/>
        </mxCell>

        <mxCell id="visits" value="&lt;b&gt;MedicalVisits / Врачебные приёмы&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; visit_id : bigint&lt;br&gt;&lt;b&gt;FK, UQ&lt;/b&gt; appointment_id → Appointments.appointment_id&lt;br&gt;complaints : text NULL&lt;br&gt;anamnesis : text NULL&lt;br&gt;examination_result : text NULL&lt;br&gt;conclusion : text NULL&lt;br&gt;recommendations : text NULL&lt;br&gt;created_at : timestamptz" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1">

        <mxCell id="patients" value="&lt;b&gt;Patients / Пациенты&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; patient_id : bigint&lt;br&gt;last_name : varchar(100)&lt;br&gt;first_name : varchar(100)&lt;br&gt;middle_name : varchar(100) NULL&lt;br&gt;birth_date : date&lt;br&gt;sex : varchar(10)&lt;br&gt;phone : varchar(30)&lt;br&gt;email : varchar(254) NULL&lt;br&gt;city : varchar(100) NULL&lt;br&gt;street : varchar(150) NULL&lt;br&gt;house : varchar(20) NULL&lt;br&gt;apartment : varchar(20) NULL&lt;br&gt;&lt;i&gt;full_name вычисляется, не хранится&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="280" height="340" as="geometry"/>

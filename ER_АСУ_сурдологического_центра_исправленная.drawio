        <mxCell id="title" value="&lt;b&gt;ER-диаграмма БД АСУ сурдологического центра&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Исправленная логическая/физическая модель&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="420" y="10" width="1320" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="users" value="&lt;b&gt;Users / Пользователи&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; user_id : bigint&lt;br&gt;last_name : varchar(100)&lt;br&gt;first_name : varchar(100)&lt;br&gt;middle_name : varchar(100) NULL&lt;br&gt;login : varchar(100) &lt;b&gt;UQ&lt;/b&gt;&lt;br&gt;password_hash : varchar(255)&lt;br&gt;role : varchar(20)&lt;br&gt;is_active : boolean&lt;br&gt;created_at : timestamptz&lt;br&gt;&lt;i&gt;full_name вычисляется, не хранится&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="280" height="260" as="geometry"/>
        </mxCell>

        <mxCell id="doctors" value="&lt;b&gt;DoctorProfiles / Профили врачей&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK, FK&lt;/b&gt; user_id → Users.user_id&lt;br&gt;specialization : varchar(100)&lt;br&gt;is_accepting_appointments : boolean&lt;br&gt;&lt;br&gt;&lt;i&gt;Гарантирует, что doctor_id ссылается именно на врача&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="80" width="290" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="schedule_templates" value="&lt;b&gt;DoctorScheduleTemplates / Шаблоны расписания&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; template_id : bigint&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; doctor_id → DoctorProfiles.user_id&lt;br&gt;weekday : smallint&lt;br&gt;start_time : time&lt;br&gt;end_time : time&lt;br&gt;slot_duration_min : smallint&lt;br&gt;valid_from : date&lt;br&gt;valid_to : date NULL&lt;br&gt;is_active : boolean" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1">

        <mxCell id="full_edge_rules_activations" edge="1" parent="1" source="full_dss_rules" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#405565;strokeWidth=1.25;startFill=0;endFill=0;fontSize=17;fontColor=#314657;labelBackgroundColor=#FFFFFF;startArrow=ERone;endArrow=ERzeroToMany;" target="full_dss_rule_activations" value="rule_id">
